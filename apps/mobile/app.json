{
  "expo": {
    "name": "LPCV",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "lpcv",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LPCV utilise votre position pour trouver les professionnels les plus proches de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LPCV a besoin d'accéder à vos photos pour illustrer votre demande.",
          "cameraPermission": "LPCV a besoin de la caméra pour prendre une photo de votre demande."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
