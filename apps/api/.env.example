NODE_ENV=development
PORT=4000

# Local dev via docker-compose.yml a la racine du monorepo
DATABASE_URL="postgresql://lpcv:lpcv@localhost:5433/lpcv_dev?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8081"

# mock (par défaut, aucun compte requis) | twilio | africastalking
TELEPHONIE_PROVIDER="mock"
# mock (par défaut, aucun compte requis) | cinetpay | paydunya
PAIEMENT_PROVIDER="mock"
# local (par défaut, écrit sur le disque du serveur) | s3
STORAGE_PROVIDER="local"
API_PUBLIC_URL="http://localhost:4000"
# mock (par défaut, code affiché dans les logs) | twilio | sendgrid
NOTIFICATION_PROVIDER="mock"
